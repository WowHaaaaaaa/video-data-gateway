# 统一换行符：仓库里全部存 LF，检出时不转换
# 否则 Windows 上 git 会把 LF 转成 CRLF，改一个字就显示"整个文件都变了"
* text=auto eol=lf

# 二进制文件不要做换行符转换
*.exe   binary
*.dll   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.jar   binary
*.zip   binary

# 让 GitHub 正确识别语言占比
*.java  linguist-language=Java
# Windows 批处理必须是 CRLF：LF 的 .bat 在部分场景下 goto/label 会失效
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf